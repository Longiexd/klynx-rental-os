<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_deposits" model="ir.ui.view">
        <field name="name">res.config.settings.klynx.deposits</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Klynx security deposits" name="klynx_security_deposits">
                    <setting string="Security deposit liability" company_dependent="1"
                             help="Use a reconcilable current liability account, separate from rental income.">
                        <field name="klynx_deposit_liability_account_id" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Damage compensation income" company_dependent="1">
                        <field name="klynx_deposit_income_account_id" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Deposit adjustment journal" company_dependent="1">
                        <field name="klynx_deposit_journal_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
